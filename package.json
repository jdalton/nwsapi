    "test:audit:focused": "node --test test/resolver-execution.test.cjs test/ancestor-filter.test.cjs test/not-extracted.test.cjs test/descend-extracted.test.cjs test/hover-extracted.test.cjs test/forgiving-list-items.test.cjs test/relative-has.test.cjs test/media-state-gaps.test.cjs test/attribute-equality.test.cjs test/integration-legacy.test.cjs test/attribute-parse-error.test.cjs"
  },
  "devDependencies": {
    "jsdom": "30.0.1",
    "jsdom-reentry": "npm:jsdom@26.1.0",
    "@playwright/test": "1.62.1"
