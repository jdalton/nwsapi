{
  "name": "nwsapi",
  "version": "2.2.27",
  "description": "Fast CSS Selectors API Engine",
  "homepage": "https://javascript.nwbox.com/nwsapi/",
  "main": "./src/nwsapi",
  "files": [
    "dist/nwsapi.min.js",
    "src/**/*.js"
  ],
  "keywords": [
    "css",
    "css3",
    "css4",
    "matcher",
    "selector"
  ],
  "licenses": [
    {
      "type": "MIT",
      "url": "https://javascript.nwbox.com/nwsapi/MIT-LICENSE"
    }
  ],
  "license": "MIT",
  "author": {
    "name": "Diego Perini",
    "email": "diego.perini@gmail.com",
    "web": "https://www.iport.it/"
  },
  "maintainers": [
    {
      "name": "Diego Perini",
      "email": "diego.perini@gmail.com",
      "web": "https://www.iport.it/"
    }
  ],
  "bugs": {
    "url": "https://github.com/dperini/nwsapi/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dperini/nwsapi.git"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/css-tree": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "acorn": "catalog:",
    "ast-v8-to-istanbul": "catalog:",
    "istanbul-lib-coverage": "catalog:",
    "istanbul-lib-report": "catalog:",
    "istanbul-reports": "catalog:",
    "jsdom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": [
      {
        "name": "pnpm",
        "version": "^11.25.0 || >=12.3.4",
        "onFail": "error"
      }
    ]
  },
  "allowScripts": {
    "fsevents": false
  },
  "overrides": {
    "vite": "$vite",
    "rolldown": "$rolldown"
  },
  "peerDependencies": {
    "css-tree": "^3.2.1"
  },
  "peerDependenciesMeta": {
    "css-tree": {
      "optional": true
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mts",
    "lint": "node scripts/lint.mts",
    "format": "oxfmt --config .config/oxfmt.json scripts test/*.test.mts test/jsdom-adapter-package.mts test/upstream/*.mts .config/*.mts .config/*.d.ts",
    "format:check": "oxfmt --check --config .config/oxfmt.json scripts test/*.test.mts test/jsdom-adapter-package.mts test/upstream/*.mts .config/*.mts .config/*.d.ts",
    "build": "node scripts/build.mts",
    "min": "node scripts/build.mts",
    "prepack": "node scripts/build.mts",
    "serve": "node scripts/serve.mts",
    "test": "vitest run --config .config/vitest.config.mts",
    "type": "tsc --noEmit -p .config/tsconfig.check.json",
    "test:node": "vitest run --config .config/vitest.config.mts",
    "test:watch": "vitest --watch --config .config/vitest.config.mts",
    "test:coverage": "node scripts/coverage.mts",
    "gen:coverage": "node scripts/gen/coverage-badge.mts",
    "check:coverage": "node scripts/gen/coverage-badge.mts --check",
    "test:package": "node test/jsdom-adapter-package.mts",
    "test:upstream": "node scripts/build.mts && playwright test --config .config/playwright.config.mts",
    "upstream:clone": "node scripts/git-partial-submodule.mts clone",
    "upstream:verify": "node scripts/git-partial-submodule.mts verify",
    "test:attributes": "vitest run --config .config/vitest.config.mts test/attribute-parse-error.test.mts",
    "test:attributes:browser": "NWSAPI_BROWSER=1 vitest run --config .config/vitest.config.mts test/attribute-strings-browser.test.mts",
    "test:browser": "NWSAPI_BROWSER=1 vitest run --config .config/vitest.config.mts"
  }
}
